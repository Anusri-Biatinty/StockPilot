# Copy to .env and adjust. Never commit the real .env file.

# --- Database (used by docker-compose and the backend) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=stockpilot
DB_USERNAME=stockpilot
DB_PASSWORD=change-me

# --- Backend ---
SERVER_PORT=8090
SPRING_PROFILES_ACTIVE=dev
# Generate with: openssl rand -base64 48   (must decode to at least 32 bytes)
JWT_SECRET=replace-with-a-long-random-base64-secret
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:5173
# true only when served over HTTPS
COOKIE_SECURE=false

# --- Email notifications (optional) ---
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=stockpilot@localhost

# --- Frontend (frontend/.env) ---
VITE_API_PROXY_TARGET=http://localhost:8090
